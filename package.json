{
  "name": "lystar-code-extensions",
  "version": "0.1.0",
  "description": "TypeSafe extensions for Pi coding agents",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "typesafe",
    "coding-agent"
  ],
  "files": [
    "extensions/typesafe-core.mjs",
    "extensions/lystar-jev-guard.ts",
    "extensions/lystar-jev-compaction.ts",
    "extensions/lystar-jev-compaction",
    "extensions/lystar-jev-skill-planner.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "VERSION"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\" \"tests/anti-slop/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.82.0",
    "@types/node": "^22.0.0",
    "typebox": "1.1.38",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./extensions/lystar-jev-guard.ts",
      "./extensions/lystar-jev-compaction.ts",
      "./extensions/lystar-jev-skill-planner.ts"
    ]
  }
}
